# ============================================================
#  razorpay_webhook — Environment Variables
#  ──────────────────────────────────────────────────────────
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real values below.
#  3. NEVER commit .env to version control.
# ============================================================


# ── Razorpay ──────────────────────────────────────────────────────────────────

# API keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for testing, rzp_live_... for production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook signing secret — REQUIRED in production to verify requests are
# genuinely from Razorpay and not spoofed.
#
# How to get it:
#   1. Go to Razorpay Dashboard → Settings → Webhooks
#   2. Click "Create New Webhook"
#   3. Set URL to:  https://<your-domain>/webhook
#   4. Enable event:  payment_link.paid
#   5. Copy the "Secret" shown — paste it here.
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Telegram ──────────────────────────────────────────────────────────────────

# Your bot's token from @BotFather.
# This service sends messages DIRECTLY via the Bot API HTTP endpoint — it does
# NOT share the bot process or its aiogram event loop.
BOT_TOKEN=

# Comma-separated Telegram user IDs with admin access.
# Paid-folder approval requests are sent here (or to ADMIN_GROUP_ID if set).
# Example: ADMINS=111111111,222222222
ADMINS=

# (Optional) Telegram group/supergroup ID for approval notifications.
# If set, approval requests go here instead of the first admin's DM.
# Example: ADMIN_GROUP_ID=-1001234567890
ADMIN_GROUP_ID=

# Admin contact shown to users in messages (e.g. "Contact @mybot for help").
# Example: ADMIN_CONTACT=@myusername
ADMIN_CONTACT=@admin


# ── Database ──────────────────────────────────────────────────────────────────

# Must point to the SAME database used by the bot — they share all tables.
#
# ⚠️  This service runs on Render — use the Supabase TRANSACTION POOLER URL,
#     NOT the direct connection string. Render cannot reach Supabase's direct
#     host (IPv6), and the pooler is more efficient for bursty webhook traffic.
#
#     Supabase → Project Settings → Database → Connection Pooling
#       Mode: Transaction   Port: 6543
#     Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# ⚠️  SPECIAL CHARACTERS IN PASSWORD — must be percent-encoded in the URI:
#     @  →  %40     #  →  %23     %  →  %25
DB_STRING=


# ── Server ────────────────────────────────────────────────────────────────────

# Port this service listens on (default 8000).
# Change if the port is taken by another service.
# Ensure your reverse proxy / Render / Railway forwards HTTPS → this port.
WEBHOOK_PORT=8000

# Set to "production" to disable the /docs Swagger UI and reduce log verbosity.
# APP_ENV=production
