# ============================================================
#  bug-free-potato — Telegram Content Bot
#  Environment Variables
#  ──────────────────────────────────────────────
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real values below.
#  3. NEVER commit .env to version control.
# ============================================================


# ── Telegram ──────────────────────────────────────────────────────────────────

# Bot token obtained from @BotFather
API_TOKEN=

# Comma-separated Telegram user IDs who have admin access.
# The FIRST ID in the list receives all approval/rejection notifications.
# Example: ADMINS=111111111,222222222
ADMINS=

# Telegram channel ID used as the file storage archive.
# The bot must be an admin of this channel.
# Use the numeric ID (e.g. -1001234567890) or @username.
CHANNEL=

# Telegram group/supergroup where approval requests are sent as inline buttons.
# Add the bot as a member of the group, then set this to the group's chat ID
# (usually a negative number like -1001234567890 for supergroups).
# If not set, requests are sent via DM to the first admin in ADMINS.
ADMIN_GROUP_ID=


# Sticker file_id sent to users when they /start the bot. OPTIONAL.
# Leave blank to skip the sticker entirely (bot works fine without it).
# To get a file_id: forward any sticker to @RawDataBot and copy the file_id.
# ⚠️  Must be a valid file_id — an invalid value causes /start to fail.
STICKER=

# Comma-separated list of channel usernames/IDs that users must
# be subscribed to before they can use the bot (ForcedSub).
# Example: SUBSCRIPTION=@mychannel1,@mychannel2
SUBSCRIPTION=


# ── Webhook / Hosting ─────────────────────────────────────────────────────────

# Public HTTPS URL of your deployment (no trailing slash).
# Render example:  https://your-app-name.onrender.com
# Railway example: https://your-app.up.railway.app
HOST_URL=


# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────

# Full psycopg2-compatible connection string.
# Supabase → Project Settings → Database → Connection String (URI mode).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# ⚠️  SPECIAL CHARACTERS IN PASSWORD — must be percent-encoded in the URI:
#     @  →  %40      (most common issue)
#     #  →  %23
#     %  →  %25
#     !  →  %21
#     :  →  %3A
#
# Example with special chars: password is  p@ss!word
#   postgresql://postgres:p%40ss%21word@db.<ref>.supabase.co:5432/postgres
DB_STRING=

# ── Contact & Branding ─────────────────────────────────────────────

# Human-readable name shown to users in messages (welcome, help, about, etc.).
# Each bot instance in a multi-bot setup should set its own name.
# Example: BOT_NAME=Medical Content Bot
BOT_NAME=Medical Content Bot

# Telegram handle for your admin/support account (shown in rejection messages).
# ADMIN_CONTACT=@Art3mis_adminbot

# Default caption appended to every uploaded file.
# Seeded into the current_caption table on first startup if it's empty.
# Change at any time with the /caption bot command (updates the DB, not this file).
# NOTE: The admin contact handle (ADMIN_CONTACT) is automatically appended
# as a new line after the caption on every uploaded file.
# DEFAULT_CAPTION=@Medical_Contentbot\nEver-growing archive of medical content


# ── Optional / Advanced ───────────────────────────────────────────────────────

# Flask keep-alive server port (default: 4343).
# KEEP_ALIVE_PORT=4343

# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# Hours before the bot re-notifies the admin about the same pending user's /start.
# Set to 0 to always notify (not recommended — causes admin spam).
# NOTIFY_COOLDOWN_HOURS=4


# ── Payment Mode ─────────────────────────────────────────────────────────────
#
#   manual   — no automated payments. Paid folders need admin approval via
#              /approve or inline buttons. Safe default, zero risk.
#
#   razorpay — Razorpay gateway. Requires keys below. Prices in INR.
#
#   stars    — Telegram Stars. No external gateway, no KYC. Prices in Stars.
#
PAYMENT_MODE=manual


# ── Razorpay (optional — leave blank to disable online payments) ──────────────
#
# Get your keys from: https://dashboard.razorpay.com/app/keys
#   • Use Test keys (rzp_test_...) for development
#   • Switch to Live keys (rzp_live_...) before going live
#
# RAZORPAY_KEY_ID=rzp_test_Sz7YqZ3jzVETDs
# RAZORPAY_KEY_SECRET=C3UzdXnUO7Zv0vJesZOs1GNa
#
# Webhook secret — set this AFTER creating the webhook in Razorpay dashboard.
# Razorpay Dashboard → Settings → Webhooks → Create New Webhook
#   URL: https://<your-HOST_URL>/payment/razorpay-webhook
#   Events to enable: payment_link.paid
# RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
#
# After adding the keys, use these bot commands to configure pricing:
#   /payconfig addplan "10 Days" 99 10     ← ₹99 for 10 days
#   /payconfig addplan "30 Days" 249 30    ← ₹249 for 30 days
#   /payconfig setdefault 99               ← default paid-folder price ₹99
#   /payconfig status                      ← verify connection
#   /payconfig list                        ← see all configured plans

# ── Telegram Stars (only used when PAYMENT_MODE=stars) ───────────────────────
#
# No keys needed — Stars payments are handled natively by Telegram.
# Configure pricing via bot commands after setting PAYMENT_MODE=stars:
#   /payconfig addplan "10 Days" 50 10     ← 50 Stars for 10 days
#   /payconfig addplan "30 Days" 120 30    ← 120 Stars for 30 days
#   /payconfig setdefault 30               ← default paid-folder price 30 Stars
#   /payconfig list                        ← see all configured plans
