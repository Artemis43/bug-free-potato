# ============================================================
#  bug-free-potato — Telegram Content Bot
#  Environment Variables
#  ──────────────────────────────────────────────────────────
#  1. Copy this file:  cp .env.example .env
#  2. Fill in ALL required values marked with (REQUIRED).
#  3. NEVER commit your .env to version control.
#
#  Multi-bot note:
#    Each bot instance is its own deployment (its own token, its own
#    Render/Railway service). All instances share one Supabase database.
#    Every instance needs its own .env with a unique API_TOKEN and BOT_ID.
#    Variables like DB_STRING, ADMINS, and PAYMENT_MODE are typically the
#    same across all instances.
# ============================================================


# ── Bot Identity ──────────────────────────────────────────────────────────────

# (REQUIRED) Bot token obtained from @BotFather.
API_TOKEN=

# Unique key that identifies THIS bot process in the shared database.
# Multi-bot deployments: each instance must have a different BOT_ID so the
# system can track which bot is paired with which storage channels.
# Single-bot setup: leave as 'main' — no extra config needed.
# Example (multi-bot): BOT_ID=bot_anatomy  or  BOT_ID=bot_physiology
BOT_ID=main

# Human-readable name shown to users in all messages (welcome, help, about…).
# Each bot in a multi-bot setup should set its own name here.
# Example: BOT_NAME=Anatomy Content Bot
BOT_NAME=Medical Content Bot


# ── Admins ────────────────────────────────────────────────────────────────────

# (REQUIRED) Comma-separated Telegram user IDs who have admin access.
# The FIRST ID in this list receives all approval/rejection/error alerts.
# Example: ADMINS=111111111,222222222
ADMINS=

# Telegram group/supergroup where new-user approval requests are posted as
# inline Approve / Reject buttons. Add the bot as a member of the group, then
# set this to the group's chat ID (a negative number like -1001234567890
# for supergroups). If not set, requests are sent as DMs to the first admin.
ADMIN_GROUP_ID=

# Telegram handle for your admin/support account.
# Shown in rejection messages, verification instructions, and upgrade prompts.
# Example: ADMIN_CONTACT=@YourAdminHandle
ADMIN_CONTACT=@Art3mis_adminbot


# ── Storage Channels ─────────────────────────────────────────────────────────
#
# Storage channels are configured at RUNTIME via bot commands — not via env.
# This means you do NOT hardcode channel IDs here.
#
# How it works:
#   1. Create a private Telegram channel and add the bot as admin.
#   2. Send /addchannel <chat_id> [optional title] to the bot.
#   3. The bot verifies its admin status and registers the channel in the DB.
#   4. Every file uploaded through the bot is mirrored to ALL active channels.
#   5. Each bot process can only serve downloads from channels it is admin of.
#
# Useful admin commands:
#   /channels                    — list all storage channels + replica counts
#   /addchannel -1001234567890   — add a channel (bot must be admin there first)
#   /togglechannel_<id>          — enable or disable a channel
#   /removechannel_<id>          — remove a channel (drops its replica records)
#
# ⚠️  The legacy CHANNEL= env var is no longer used. Use /addchannel instead.
# (It is still read by config.py for backward compatibility, but has no effect
#  in the new multi-channel architecture.)
# CHANNEL=


# ── Subscriptions (ForcedSub) ─────────────────────────────────────────────────

# Optional. Comma-separated channel usernames or IDs that users must be
# subscribed to before they can access the bot.
# Example: SUBSCRIPTION=@mychannel,@mybackupchannel
SUBSCRIPTION=

# Optional. Sticker file_id sent to users when they /start the bot.
# Leave blank to skip (the bot works fine without it).
# To find a file_id: forward any sticker to @RawDataBot and copy the file_id.
# ⚠️  An invalid file_id causes /start to fail — test before deploying.
STICKER=


# ── Webhook / Hosting ─────────────────────────────────────────────────────────

# (REQUIRED) Public HTTPS URL of your deployment — no trailing slash.
# This is used to construct the webhook URL that Telegram calls.
# Render example:  HOST_URL=https://your-app-name.onrender.com
# Railway example: HOST_URL=https://your-app.up.railway.app
HOST_URL=


# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────

# (REQUIRED) psycopg2-compatible PostgreSQL connection string.
# Supabase: Project Settings → Database → Connection String (URI / psycopg2 mode).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# ⚠️  SPECIAL CHARACTERS IN PASSWORD — percent-encode them in the URI:
#     @  →  %40      (most common issue)
#     #  →  %23
#     %  →  %25
#     !  →  %21
#     :  →  %3A
#
# Example with special chars (password = p@ss!word):
#   postgresql://postgres:p%40ss%21word@db.<ref>.supabase.co:5432/postgres
DB_STRING=


# ── Caption & Branding ────────────────────────────────────────────────────────

# Default caption appended to every uploaded file.
# Seeded into the current_caption table on first startup if the table is empty.
# You can change it at any time with the /caption bot command — that updates
# the database and takes effect immediately without a restart.
#
# ⚠️  ADMIN_CONTACT is ALWAYS appended as a new line after the caption,
#     regardless of caption mode (custom or append). Set it above.
#
# DEFAULT_CAPTION=@YourBotUsername\nEver-growing archive of content


# ── Optional / Advanced ───────────────────────────────────────────────────────

# Port for the Flask keep-alive server (used by UptimeRobot / Render free tier).
# Default: 4343
# KEEP_ALIVE_PORT=4343

# Python log level. Default: INFO
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# Minimum hours between re-notifying admins about the same pending user's /start.
# Set to 0 to notify on every /start (not recommended — causes admin spam).
# Default: 4
# NOTIFY_COOLDOWN_HOURS=4


# ── Access Control ────────────────────────────────────────────────────────────

# Controls whether new users require admin approval before they can browse
# and download content.
#
#   true  (default) — Users start as "pending" and must be approved by an admin
#                      via the Approve button or /setuser before they can access
#                      anything. This is the original behaviour.
#
#   false           — All users are auto-approved the moment they /start the bot.
#                      The pending/rejected flow is completely skipped. Useful for
#                      public bots or testing.
#
REQUIRE_APPROVAL=true

# Controls whether the bot sends a sticker animation on /start before showing
# the main menu.
#
#   true  (default) — The STICKER file_id (if set) is sent, displayed briefly,
#                      then auto-deleted. Adds a visual flourish on start.
#
#   false           — No sticker is sent. The main menu appears instantly,
#                      reducing load time. Recommended if you haven't set a
#                      STICKER file_id or want a snappier UX.
#
SEND_STICKER=true


# ── Payment Mode ─────────────────────────────────────────────────────────────
#
# Controls how premium upgrades and paid-folder access work:
#
#   manual   — No automated payments. Premium and paid-folder access must be
#              granted manually by an admin via /setuser or inline Approve buttons.
#              Safe default. Zero external dependencies.
#
#   razorpay — Razorpay payment gateway. Users pay via a payment link; premium
#              is activated automatically on successful payment. Prices in INR.
#              Requires the Razorpay keys below.
#
#   stars    — Telegram Stars (Telegram's native in-app currency). No external
#              gateway, no KYC, no bank account needed. Prices in Stars.
#
PAYMENT_MODE=manual


# ── Razorpay (only used when PAYMENT_MODE=razorpay) ──────────────────────────
#
# Get your API keys from: https://dashboard.razorpay.com/app/keys
#   • Use Test keys (rzp_test_…) during development
#   • Switch to Live keys (rzp_live_…) before going live
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#
# Webhook secret — set this AFTER creating the webhook in your Razorpay dashboard:
#   Razorpay Dashboard → Settings → Webhooks → Create New Webhook
#   Webhook URL:     https://<your-HOST_URL>/webhook
#   Events to enable: payment_link.paid
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
#
# After adding the keys, configure pricing via bot commands:
#   /payconfig addplan "10 Days" 99 10     ← ₹99 for 10 days of premium
#   /payconfig addplan "30 Days" 249 30    ← ₹249 for 30 days of premium
#   /payconfig setdefault 99               ← default price for paid folders (₹99)
#   /payconfig status                      ← verify Razorpay connection
#   /payconfig list                        ← see all configured plans


# ── Telegram Stars (only used when PAYMENT_MODE=stars) ───────────────────────
#
# No API keys needed — Stars are handled natively by Telegram.
# Configure pricing via bot commands after setting PAYMENT_MODE=stars:
#   /payconfig addplan "10 Days" 50 10     ← 50 Stars for 10 days of premium
#   /payconfig addplan "30 Days" 120 30    ← 120 Stars for 30 days of premium
#   /payconfig setdefault 30               ← default price for paid folders (30 Stars)
#   /payconfig list                        ← see all configured plans


# ── Content Catalog (Telegra.ph) ──────────────────────────────────────────────
#
# The bot can auto-publish a browsable Telegra.ph page listing all categories
# and folders with deep links back to the bot.
#
# The Telegra.ph account is created automatically on first /catalog run.
# BOT_NAME is used as both the Telegra.ph author name AND the account short_name.
# You do NOT need a Telegra.ph token — it is created and stored in the database.
#
# The catalog auto-regenerates (rate-limited to once per 5 minutes) whenever:
#   • A folder is created, renamed, or deleted
#   • A category is created, renamed, deleted, or modified
#   • An admin runs /catalog (forced regeneration, bypasses rate limit)
#
# Commands:
#   /catalog      — generate / update catalog (admin: force; user: show URL)
#   /catalogurl   — show current catalog URL without regenerating
#
# No env vars needed — everything is stored in the database (payment_config table).


# ── Search ────────────────────────────────────────────────────────────────────
#
# Full-text and fuzzy search is built-in.  No configuration required.
#
# How it works:
#   1. Exact match     — case-insensitive full name match
#   2. Prefix match    — name starts with the query
#   3. Substring match — name contains the query
#   4. FTS             — tsvector full-text search (PostgreSQL)
#   5. Trigram fuzzy   — pg_trgm similarity (auto-enabled if extension exists)
#
# Inline search (anywhere in Telegram):
#   @YourBotUsername <query>
#   → requires "Inline Mode" to be enabled for your bot via @BotFather
#
# Commands:
#   /search [query]  — search folders (omit query to enter interactive mode)

